#!/bin/sh
# Script to launch dmenu with colors matching dracula theme
# Author: Vic Fryzel
# http://github.com/vicfryzel/xmonad-config
# Modifier: Benjamin Langguth
# http://github.com/blangguth/xmonad-config

$(dmenu_path | yeganesh -- -fn 'Fira Code:pixelsize=11:antialias=true' \
  -nb '#282A36' -nf '#F8F8F2' -sb '#BD93F9' -sf '#282A36')
